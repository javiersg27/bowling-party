# Copia este archivo a .env.local y rellena los valores PÚBLICOS de tu proyecto Supabase.
# .env.local está ignorado por git: aquí NO se versionan secretos.
#
# NUNCA pongas la clave "secret" (sb_secret_...) ni la antigua "service_role".
# Esas bypassean RLS y darían acceso total a la base de datos.

# URL del proyecto (Dashboard → Connect → Project URL).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública de bajos privilegios. Acepta:
#   - la "publishable key" nueva  → sb_publishable_xxxxxxxx
#   - o la "anon key" clásica (JWT largo)
# Ambas son seguras en el navegador PORQUE RLS limita lo que se puede leer/escribir.
# (Supabase retira anon/service_role a fin de 2026; usa la publishable.)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Ruta base para GitHub Pages. En local déjalo vacío o "/".
# En Actions se inyecta automáticamente como /NOMBRE_REPOSITORIO/
# VITE_BASE_PATH=/bowling-party/

